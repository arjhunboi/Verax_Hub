-- widgets
local function button(parent, text, cb)
	local b = mk("TextButton", {Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = BLACK, Text = text, TextColor3 = GREEN, Font = Enum.Font.GothamBold, TextSize = 14}, parent)
	round(b, 5) stroke(b)
	b.MouseButton1Click:Connect(function() cb(b) end)
	return b
end

local function toggle(parent, text, cb)
	local on = false
	local b
	b = button(parent, text .. ": OFF", function()
		on = not on
		b.Text = text .. (on and ": ON" or ": OFF")
		b.BackgroundColor3 = on and Color3.fromRGB(0, 90, 40) or BLACK
		cb(on)
	end)
	return b
end

local function input(parent, label, default, cb)
	local row = mk("Frame", {Size = UDim2.new(1, 0, 0, 32), BackgroundTransparency = 1}, parent)
	mk("TextLabel", {Size = UDim2.new(0.5, 0, 1, 0), BackgroundTransparency = 1, Text = label, TextColor3 = GREEN, Font = Enum.Font.GothamBold, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left}, row)
	local tb = mk("TextBox", {Size = UDim2.new(0.5, 0, 1, 0), Position = UDim2.new(0.5, 0, 0, 0), BackgroundColor3 = BLACK, Text = tostring(default), TextColor3 = GREEN, Font = Enum.Font.Gotham, TextSize = 14, ClearTextOnFocus = false}, row)
	round(tb, 5) stroke(tb)
	tb.FocusLost:Connect(function()
		local n = tonumber(tb.Text)
		if n then cb(n) else tb.Text = tostring(default) end
	end)
	return tb
end

local function runSafe(fn, name)
	task.spawn(function()
		local ok, err = pcall(fn)
		if not ok then warn(name .. " error: " .. tostring(err)) notify(name .. " failed") end
	end)
end

